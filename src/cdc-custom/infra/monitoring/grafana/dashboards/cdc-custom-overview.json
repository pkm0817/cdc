{
  "uid": "cdc-custom",
  "title": "CDC Custom (outbox) Overview",
  "tags": [
    "cdc",
    "cdc-custom",
    "outbox"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Source 행 수",
      "description": "source DB 테이블별 정확한 행 수. publication 에 든 테이블이 자동으로 잡힌다",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cdc-custom-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cdc_source_rows",
          "legendFormat": "{{table_name}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Target 행 수 (활성)",
      "description": "소프트 삭제된 행은 뺀 수. source 와 같은 기준이라 그대로 비교된다",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cdc-custom-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cdc_target_rows",
          "legendFormat": "{{table_name}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "정합성 차이 |source − target|",
      "description": "0 이 아니면 아직 반영 중이거나 유실된 것이다",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cdc-custom-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "abs(cdc_source_rows - on(table_name) cdc_target_rows)",
          "legendFormat": "{{table_name}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "소프트 삭제 / Sink 오류",
      "description": "DELETE 가 실제로 반영됐는지, 적재 중 실패가 있었는지",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cdc-custom-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cdc_target_deleted_rows",
          "legendFormat": "삭제 {{table_name}}",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "sum(cdc_sink_errors_total) or vector(0)",
          "legendFormat": "sink 오류",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CDC 이벤트 처리량 (events/sec)",
      "description": "테이블·연산별 초당 처리 건수",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cdc-custom-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (table, op) (rate(cdc_events_total[1m]))",
          "legendFormat": "{{table}} {{op}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "End-to-End 지연 (변경 기록 → target 반영)",
      "description": "원천 커밋 시각과 적재 시각의 차이",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cdc-custom-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cdc_end_to_end_lag_seconds_max",
          "legendFormat": "최대"
        },
        {
          "refId": "B",
          "expr": "rate(cdc_end_to_end_lag_seconds_sum[1m]) / rate(cdc_end_to_end_lag_seconds_count[1m])",
          "legendFormat": "평균"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "행 수 추이 — source vs target",
      "description": "두 선이 벌어졌다 붙는 폭이 곧 복제 지연이다",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cdc-custom-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cdc_source_rows",
          "legendFormat": "source {{table_name}}"
        },
        {
          "refId": "B",
          "expr": "cdc_target_rows",
          "legendFormat": "target {{table_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Outbox 적체 — 미반영 줄 수 · 최장 대기",
      "description": "이 방식에는 복제 슬롯이 없다. 컨슈머가 멈추면 WAL 이 아니라 outbox 표가 자란다. 줄 수보다 최장 대기 시간이 먼저 신호가 된다 — 줄이 적어도 오래 묵어 있으면 워커가 멈춘 것이다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cdc-custom-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cdc_outbox_pending",
          "legendFormat": "미반영 줄 수",
          "datasource": {
            "type": "prometheus",
            "uid": "cdc-custom-prom"
          }
        },
        {
          "refId": "B",
          "expr": "cdc_outbox_oldest_age_seconds",
          "legendFormat": "최장 대기(초)",
          "datasource": {
            "type": "prometheus",
            "uid": "cdc-custom-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "none",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "최장 대기(초)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
