# 상위 디렉터리의 lombok.config 를 찾아 올라가지 않는다 (이 프로젝트가 루트다)
config.stopBubbling = true

# 생성된 메서드에 @lombok.Generated 를 붙인다.
# JaCoCo 같은 커버리지 도구가 생성 코드를 측정 대상에서 제외할 수 있게 된다.
lombok.addLombokGeneratedAnnotation = true

# @Data, @Value 는 JPA 엔티티에서 위험하다(equals/hashCode 와 toString 이
# 연관 필드를 건드려 지연 로딩을 유발한다). 실수로 쓰지 못하게 아예 막는다.
lombok.data.flagUsage = ERROR
lombok.value.flagUsage = ERROR
